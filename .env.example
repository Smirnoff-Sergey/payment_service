# Secrets (API_KEY, WEBHOOK_SECRET) are read from ./secrets/, see README.
# An environment variable with the same name overrides the secret file.

# Optional overrides (defaults in app/config.py)
# MAX_RETRIES=3
# RETRY_BASE_DELAY=1.0
# GATEWAY_MIN_DELAY=2.0
# GATEWAY_MAX_DELAY=5.0
# GATEWAY_SUCCESS_RATE=0.9
# WEBHOOK_TIMEOUT=5.0
# OUTBOX_POLL_INTERVAL=0.5
# OUTBOX_BATCH_SIZE=100
# OUTBOX_RETENTION_HOURS=24
# CLEANUP_INTERVAL=60
# CLEANUP_BATCH_SIZE=1000
# IDEMPOTENCY_KEY_TTL_HOURS=24
# WEBHOOK_ALLOWED_HOSTS=webhook-mock
